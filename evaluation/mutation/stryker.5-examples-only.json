{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["app/lib/analytics/scores.ts"],
  "testRunner": "command",
  "commandRunner": { "command": "node --no-warnings --test evaluation/tests/worked-example.test.mjs evaluation/tests/example.test.mjs" },
  "coverageAnalysis": "off",
  "inPlace": true,
  "disableTypeChecks": false,
  "concurrency": 2,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "json"],
  "clearTextReporter": { "logTests": false, "reportMutants": false },
  "jsonReporter": { "fileName": "evaluation/results/offline/mutation-5-examples-only.json" },
  "tempDirName": "evaluation/.stryker-tmp"
}
